# Application Configuration
APP_ENV=development
APP_NAME=Enterprise KMS & Secret Vault
HOST=127.0.0.1
PORT=8000

# Cryptographic Keys (For local development only - override in production)
# 256-bit (32 bytes) hex-encoded Root Key Encryption Key (Root KEK)
SERVER_ROOT_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC Secret Key for Cryptographic Audit Trail Chaining
AUDIT_HMAC_SECRET=supersecret-audit-hmac-key-minimum-32-bytes-long

# JWT / Session Secret Key
SECRET_KEY=dev-session-secret-key-replace-with-cryptographically-random-value
SESSION_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./keyvault.db

# Defensive Security Controls
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
